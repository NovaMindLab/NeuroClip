{
  "$schema": "https://raw.githubusercontent.com/nice-registry/tauri-schema/main/schemas/v2/tauri.conf.json",
  "productName": "NeuroClip",
  "version": "0.1.0",
  "identifier": "com.novamind.neuroclip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeuroClip - AI 自动化长视频高光切片与智能解说系统",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
